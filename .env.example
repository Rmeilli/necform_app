# === Configuration Docker Necform ===
# Copie ce fichier en .env et remplace les valeurs par tes vrais secrets

# Base de données PostgreSQL
POSTGRES_DB=necform
POSTGRES_USER=necform
POSTGRES_PASSWORD=necform
POSTGRES_PORT=5432

# Ports des services
BACKEND_PORT=8080
GATEWAY_PORT=8081
AI_SERVICE_PORT=8082
FRONTEND_PORT=4200
KEYCLOAK_PORT=8180

# Profil Spring (docker, test, prod...)
SPRING_PROFILES_ACTIVE=docker

# Clés API (optionnel - laisser vide si non utilisé)
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# Keycloak (optionnel)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin